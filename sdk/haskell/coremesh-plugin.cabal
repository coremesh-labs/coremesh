cabal-version: 3.0
name:          coremesh-plugin
version:       0.1.0
synopsis:      Plugin-SDK für CoreMesh in Haskell
description:
  Haskell-Plugins für den CoreMesh-Host: go-plugin-Handshake mit AutoMTLS,
  gRPC-Broker, PluginService (GetManifest, Configure, Handle, Read) und der
  Rückkanal HostService (Dispatch, DispatchRead, Query, Exec, Transaktionen, Log).
  Läuft unter Linux, macOS und Windows (nur Haskell-Bibliotheken, kein C außer
  dem, was GHC selbst braucht).
license:       NONE
build-type:    Simple
tested-with:   GHC == 9.10.3
extra-doc-files:
  README.md
extra-source-files:
  proto/README.md
  proto/goplugin/*.proto
  proto/grpc/health/v1/*.proto

common lang
  default-language:   GHC2021
  default-extensions: OverloadedStrings, LambdaCase, RecordWildCards, DerivingStrategies
  ghc-options:        -Wall -Wno-name-shadowing

library
  import:          lang
  hs-source-dirs:  src, gen
  exposed-modules:
    CoreMesh.Plugin
    CoreMesh.Plugin.Value
    CoreMesh.Plugin.Internal.Grpc
    CoreMesh.Plugin.Internal.Tls
    CoreMesh.Plugin.Internal.Context
  other-modules:
    CoreMesh.Plugin.Internal.Host
    CoreMesh.Plugin.Internal.Serve
    Proto.Plugin.V1.Plugin
    Proto.Plugin.V1.Plugin_Fields
    Proto.Plugin.V1.Host
    Proto.Plugin.V1.Host_Fields
    Proto.Goplugin.GrpcBroker
    Proto.Goplugin.GrpcBroker_Fields
    Proto.Goplugin.GrpcController
    Proto.Goplugin.GrpcController_Fields
    Proto.Goplugin.GrpcStdio
    Proto.Goplugin.GrpcStdio_Fields
    Proto.Grpc.Health.V1.Health
    Proto.Grpc.Health.V1.Health_Fields
  -- Generierter Code (proto-lens) erzeugt Warnungen, die wir nicht beheben.
  ghc-options:     -Wno-unused-imports -Wno-missing-export-lists
  build-depends:
      base                      >= 4.18 && < 5
    , aeson                     >= 2.1  && < 2.3
    , async                     >= 2.2  && < 2.3
    , base64-bytestring         >= 1.2  && < 1.3
    , bytestring                >= 0.11 && < 0.13
    , containers                >= 0.6  && < 0.9
    , crypton                   >= 1.0  && < 2.2
    , crypton-pem               >= 0.2  && < 0.4
    , crypton-x509              >= 1.7  && < 1.11
    , crypton-x509-validation   >= 1.6  && < 1.10
    , crypton-asn1-types        >= 0.3  && < 0.5
    , time-hourglass            >= 0.3  && < 0.4
    , data-default              >= 0.7  && < 0.9
    , deepseq                   >= 1.4  && < 1.6
    , http-semantics            >= 0.3  && < 0.4
    , http-types                >= 0.12 && < 0.13
    , http2                     >= 5.3.9 && < 5.4
    , case-insensitive          >= 1.2  && < 1.3
    , lens-family               >= 2.1  && < 2.2
    , network                   >= 3.1  && < 3.3
    , proto-lens                >= 0.7  && < 0.8
    , proto-lens-protobuf-types >= 0.7  && < 0.8
    , proto-lens-runtime        >= 0.7  && < 0.8
    , ram                       >= 0.20 && < 0.23
    , scientific                >= 0.3  && < 0.4
    , stm                       >= 2.5  && < 2.6
    , text                      >= 2.0  && < 2.2
    , time                      >= 1.12 && < 1.15
    , time-manager              >= 0.3  && < 0.4
    , tls                       >= 2.1  && < 2.5
    , vector                    >= 0.13 && < 0.14


test-suite spec
  import:          lang
  type:            exitcode-stdio-1.0
  hs-source-dirs:  test
  main-is:         Main.hs
  ghc-options:     -threaded
  build-depends:
      base
    , aeson
    , bytestring
    , coremesh-plugin
    , http2
    , network

executable coremesh-hs-hello
  import:          lang
  hs-source-dirs:  example
  main-is:         Main.hs
  ghc-options:     -threaded -rtsopts
  build-depends:
      base
    , aeson
    , coremesh-plugin
    , text
